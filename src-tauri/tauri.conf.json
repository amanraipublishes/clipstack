{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipStack",
  "version": "0.1.0",
  "identifier": "com.rai00.clipstack",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ClipStack",
        "width": 520,
        "height": 460,
        "minWidth": 380,
        "minHeight": 260,
        "center": true,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "windowEffects": {
          "effects": ["acrylic"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
